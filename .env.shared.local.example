# Copy this file to .env.shared.local and replace every placeholder locally.
# Never commit .env.shared.local or real credentials.

IDENTITY_DB_PASSWORD=replace-with-local-identity-database-password
SCHOOL_SERVICE_DB_PASSWORD=replace-with-local-school-database-password
ACADEMIC_SERVICE_DB_PASSWORD=replace-with-local-academic-database-password

# Every service must receive this same value for calls to identity-service.
IDENTITY_INTERNAL_API_KEY=replace-with-one-shared-identity-internal-api-key

# School and academic services must receive these same values.
SCHOOL_INTERNAL_API_KEY=replace-with-one-shared-school-internal-api-key
ACADEMIC_INTERNAL_API_KEY=replace-with-one-shared-academic-internal-api-key

SCHOOL_DEFAULT_TIME_ZONE=Asia/Kolkata
